{
  "name": "Memory Timeline",
  "short_name": "Memory Timeline",
  "description": "A private visual timeline for saving and revisiting personal memories.",
  "id": "/",
  "start_url": "/timeline",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "icons": [
    {
      "src": "/memory-timeline-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
